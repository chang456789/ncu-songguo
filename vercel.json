{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "web",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/events.js": {
      "maxDuration": 30
    },
    "api/places.js": {
      "maxDuration": 30
    },
    "api/ai-translate.js": {
      "maxDuration": 30
    },
    "api/ai-chat.js": {
      "maxDuration": 30
    },
    "api/ai-chatroom.js": {
      "maxDuration": 30
    },
    "api/ai-ride.js": {
      "maxDuration": 30
    },
    "api/ai-today.js": {
      "maxDuration": 30
    },
    "api/ai-agent.js": {
      "maxDuration": 30
    },
    "api/responsible-ai.js": {
      "includeFiles": "docs/responsible-ai.md"
    }
  }
}
